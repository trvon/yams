# Arch Linux install script for YAMS
# Creates the `yams` system account, then registers, enables (per the shipped
# 80-yams.preset) and starts the system daemon; stops it on removal.

UNIT=yams-daemon.service

_yams_sysusers() {
    # pacman's sysusers hook also runs this; calling it here makes the account
    # exist before the unit (re)starts below, whatever the hook order.
    systemd-sysusers /usr/lib/sysusers.d/yams.conf >/dev/null 2>&1 || true
}

post_install() {
    _yams_sysusers
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
        systemctl preset "${UNIT}" >/dev/null 2>&1 || true
        systemctl start "${UNIT}" >/dev/null 2>&1 || true
    fi
    echo ">>> The system daemon socket is /run/yams/yams-daemon.sock (group yams)."
    echo ">>> Let a user reach it with: usermod -aG yams <user>  (then log in again)."
}

post_upgrade() {
    _yams_sysusers
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
        if systemctl is-active --quiet "${UNIT}" 2>/dev/null; then
            systemctl restart "${UNIT}" >/dev/null 2>&1 || true
        else
            systemctl preset "${UNIT}" >/dev/null 2>&1 || true
        fi
    fi
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl disable --now "${UNIT}" >/dev/null 2>&1 || true
    fi
}

post_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
    fi
    echo ">>> /var/lib/yams and /var/log/yams were kept; remove them to delete the system corpus."
}
