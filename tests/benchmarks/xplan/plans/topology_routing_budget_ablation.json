{
  "name": "topology_routing_budget_ablation",
  "description": "Compact recall-work gate for cached centroid ANN versus exhaustive topology routing and global Vec0 PHSS at the same routed document budget. 2026-08-21 fixes: (1) removed five PQ-backend-only vector_*_actual work counters from steps[].metrics/summarize.primary (plan pins YAMS_VECTOR_SEARCH_ENGINE=vec0, which emits status keys but not *_actual values); (2) added routed_cc_adaptive_ann64_docs64 arm (product topologyMaxDocs=64). NOTE: the route-risk calibration obligation requires the runtime construction fingerprint (FNV1a over construction), which is NOT stable across harness runs (observed drift: ee056c1f266d034a -> 1f615b5f60f0b5c6 -> 71382032f0827b9e across three runs), so a hardcoded calibration fingerprint can never satisfy it; narrow stays fail-closed (action=augment) until the bench gains a self-calibration mode.",
  "build_dir": "build/release",
  "artifact_root": "build/benchmarks",
  "timeout_sec": 7200,
  "continue_on_arm_failure": true,
  "mode": "live-ish",
  "repeats": 3,
  "baseline": "global_ann_c16",
  "fixed": {
    "env": {
      "YAMS_TEST_SAFE_SINGLE_INSTANCE": "1",
      "YAMS_SEARCH_STAGE_TRACE": "1",
      "YAMS_ENABLE_ENV_OVERRIDES": "1",
      "YAMS_BENCH_SEED_SEMANTIC_NEIGHBORS": "1",
      "YAMS_BENCH_TOPOLOGY_ENGINE": "connected",
      "YAMS_TOPOLOGY_MIN_EDGE_SCORE": "0.25",
      "YAMS_TOPOLOGY_MAX_COMPONENT_DOCS": "64",
      "YAMS_VECTOR_MAX_RESULTS": "32",
      "YAMS_VECTOR_SEARCH_ENGINE": "vec0",
      "YAMS_VECTOR_VEC0_PHSS_ENABLED": "1",
      "YAMS_VECTOR_VEC0_PHSS_CANDIDATES": "64"
    },
    "params": {
      "dataset": "scifact",
      "corpus_size": 2000,
      "num_queries": 50,
      "topk": 10,
      "topology_source": "vector",
      "topology_engine": "connected",
      "seed_semantic_neighbors": "1",
      "max_component_docs": 64,
      "min_edge_score": 0.25
    }
  },
  "arms": [
    {
      "name": "global_ann_c16",
      "factors": {
        "topology_mode": "disabled",
        "ann_candidate_budget": 16,
        "vector_result_budget": 32
