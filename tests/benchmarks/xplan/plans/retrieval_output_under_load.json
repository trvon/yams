{
  "name": "retrieval_output_under_load",
  "description": "Measure known-hit search, grep, and graph output liveness while the isolated benchmark daemon generates escalating concurrent read/write pressure.",
  "build_dir": "build/release",
  "artifact_root": "build/benchmarks",
  "timeout_sec": 1800,
  "continue_on_arm_failure": true,
  "mode": "synthetic",
  "repeats": 3,
  "baseline": "control",
  "fixed": {
    "env": {
      "YAMS_TEST_SAFE_SINGLE_INSTANCE": "1",
      "YAMS_SKIP_MODEL_LOADING": "1"
    },
    "params": {
      "vectors": "off",
      "doc_size": 4096,
      "warmup_docs": 32,
      "search_type": "keyword",
      "search_query": "architecture",
      "search_limit": 20,
      "profile_hydration_surfaces": true,
      "profile_output_liveness": true,
      "resource_sample_ms": 50,
      "idle_probe": "0"
    }
  },
  "arms": [
    {
      "name": "control",
      "factors": {
        "search_clients": 4,
        "docs_per_client": 100,
        "mixed_ops_per_client": 100,
        "search_ratio": 0.5
      }
    },
    {
      "name": "heavy_read",
      "factors": {
        "search_clients": 16,
        "docs_per_client": 200,
        "mixed_ops_per_client": 200,
        "search_ratio": 0.8
      }
    },
    {
      "name": "heavy_write",
      "factors": {
        "search_clients": 16,
        "docs_per_client": 200,
        "mixed_ops_per_client": 200,
        "search_ratio": 0.2
      }
    }
  ],
  "steps": [
    {
      "worker": "retrieval_load",
      "metrics": [
        "output_liveness_contract_pass",
        "known_hit_nonempty_rate",
        "known_hit_empty_success_rate",
        "known_hit_error_rate",
        "search_known_hit_empty_success_rate",
        "grep_known_hit_empty_success_rate",
        "graph_known_hit_empty_success_rate",
        "search_p95_ms",
        "qps",
        "total_ops_per_s",
        "backlog_peak",
        "write_queue_depth_peak",
        "pressure_level_peak",
        "drain_elapsed_ms"
      ]
    }
  ],
  "validate": {
    "require_files": ["metrics.json"],
    "require_metrics": [
      "output_liveness_contract_pass",
      "known_hit_empty_success_rate",
      "known_hit_error_rate",
      "search_p95_ms",
      "total_ops_per_s"
    ],
    "require_metric_status": ["ok"]
  },
  "summarize": {
    "primary": [
      "output_liveness_contract_pass",
      "known_hit_nonempty_rate",
      "known_hit_empty_success_rate",
      "known_hit_error_rate",
      "search_known_hit_nonempty_rate",
      "search_known_hit_empty_success_rate",
      "search_known_hit_error_rate",
      "grep_known_hit_nonempty_rate",
      "grep_known_hit_empty_success_rate",
      "grep_known_hit_error_rate",
      "graph_known_hit_nonempty_rate",
      "graph_known_hit_empty_success_rate",
      "graph_known_hit_error_rate",
      "search_p50_ms",
      "search_p95_ms",
      "search_p99_ms",
      "qps",
      "total_ops_per_s",
      "backlog_peak",
      "write_queue_depth_peak",
      "pressure_level_peak",
      "drain_elapsed_ms",
      "total_failures"
    ],
    "group_by": ["search_clients", "search_ratio"]
  }
}
