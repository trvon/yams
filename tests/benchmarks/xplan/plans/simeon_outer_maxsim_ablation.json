{
  "name": "simeon_outer_maxsim_ablation",
  "description": "Simeon cross-rerank single-vector cosine vs fragment outer MaxSim (whole-document sentence sampling) in replace and blend modes on BEIR scifact. Promote search.simeon_rerank_outer_maxsim only if nDCG/MRR improve beyond pooled stdev with acceptable p50.",
  "build_dir": "build/release",
  "artifact_root": "build/benchmarks",
  "timeout_sec": 5400,
  "continue_on_arm_failure": true,
  "mode": "live-ish",
  "repeats": 3,
  "baseline": "rerank_off",
  "fixed": {
    "env": {
      "YAMS_TEST_SAFE_SINGLE_INSTANCE": "1",
      "YAMS_ENABLE_ENV_OVERRIDES": "1",
      "YAMS_EMBED_BACKEND": "simeon"
    },
    "params": {
      "dataset": "scifact",
      "corpus_size": 2000,
      "num_queries": 50,
      "topk": 10,
      "embed_backend": "simeon",
      "rerank_topk": 10
    }
  },
  "arms": [
    {
      "name": "rerank_off",
      "factors": {
        "rerank_mode": "off"
      },
      "env": {
        "YAMS_SEARCH_ENABLE_RERANKING": "0"
      }
    },
    {
      "name": "replace_cosine",
      "factors": {
        "rerank_mode": "replace",
        "outer_maxsim": false
      },
      "env": {
        "YAMS_SEARCH_ENABLE_RERANKING": "1",
        "YAMS_SEARCH_RERANK_REPLACE_SCORES": "1"
      },
      "params": {
        "simeon_outer_maxsim": "0"
      }
    },
    {
      "name": "replace_maxsim",
      "factors": {
        "rerank_mode": "replace",
        "outer_maxsim": true
      },
      "env": {
        "YAMS_SEARCH_ENABLE_RERANKING": "1",
        "YAMS_SEARCH_RERANK_REPLACE_SCORES": "1"
      },
      "params": {
        "simeon_outer_maxsim": "1"
      }
    },
    {
      "name": "blend_cosine",
      "factors": {
        "rerank_mode": "blend",
        "outer_maxsim": false
      },
      "env": {
        "YAMS_SEARCH_ENABLE_RERANKING": "1",
        "YAMS_SEARCH_RERANK_REPLACE_SCORES": "0",
        "YAMS_SEARCH_RERANK_WEIGHT": "0.3"
      },
      "params": {
        "simeon_outer_maxsim": "0"
      }
    },
    {
      "name": "blend_maxsim",
      "factors": {
        "rerank_mode": "blend",
        "outer_maxsim": true
      },
      "env": {
        "YAMS_SEARCH_ENABLE_RERANKING": "1",
        "YAMS_SEARCH_RERANK_REPLACE_SCORES": "0",
        "YAMS_SEARCH_RERANK_WEIGHT": "0.3"
      },
      "params": {
        "simeon_outer_maxsim": "1"
      }
    }
  ],
  "steps": [
    {
      "worker": "retrieval_quality",
      "metrics": [
        "ndcg_at_k",
        "recall_at_k",
        "mrr",
        "search_latency_ms_p50",
        "search_latency_ms_p95",
        "cross_rerank_apply_rate",
        "proc_maxrss_mb"
      ]
    }
  ],
  "validate": {
    "require_files": [
      "metrics.json"
    ],
    "require_metrics": [
      "ndcg_at_k"
    ],
    "require_metric_status": [
      "ok"
    ]
  },
  "summarize": {
    "primary": [
      "ndcg_at_k",
      "mrr",
      "recall_at_k",
      "search_latency_ms_p50",
      "cross_rerank_apply_rate",
      "proc_maxrss_mb"
    ],
    "group_by": [
      "rerank_mode",
      "outer_maxsim"
    ]
  }
}
