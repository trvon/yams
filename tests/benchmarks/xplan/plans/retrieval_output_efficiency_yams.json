{
  "name": "retrieval_output_efficiency_yams",
  "description": "Read-only dogfood benchmark for useful search, grep, and graph evidence per serialized-output byte on the indexed YAMS codebase. Requires a ready daemon whose index contains this checkout.",
  "build_dir": "build/release",
  "artifact_root": "build/benchmarks",
  "timeout_sec": 600,
  "continue_on_arm_failure": false,
  "mode": "live-ish",
  "repeats": 3,
  "baseline": "human",
  "fixed": {
    "params": {
      "binary": "yams",
      "manifest": "tests/benchmarks/xplan/data/yams_codebase_output_tasks.json",
      "byte_budgets": [
        256,
        512,
        1024,
        2048,
        4096,
        8192,
        16384
      ],
      "efficiency_contract": {
        "profile": "agent_memory_aggressive_v1",
        "min_useful_hit_rate": 1.0,
        "min_useful_recall_at_512_bytes": 1.0,
        "min_useful_recall_at_1024_bytes": 1.0,
        "max_output_bytes_p95": 8192,
        "max_duplicate_line_fraction": 0.05,
        "min_useful_units_per_kib": 0.25,
        "max_scope_leak_path_count": 0,
        "max_search_output_bytes_p95": 2048,
        "max_graph_output_bytes_p95": 8192,
        "max_grep_output_bytes_p95": 8192,
        "max_grep_duplicate_line_fraction": 0.1
      },
      "shadow_grep_max_matches": 20,
      "task_timeout_sec": 60
    }
  },
  "arms": [
    {
      "name": "human",
      "factors": {
        "output_format": "human"
      },
      "params": {
        "output_format": "human"
      }
    },
    {
      "name": "json",
      "factors": {
        "output_format": "json"
      },
      "params": {
        "output_format": "json"
      }
    }
  ],
  "steps": [
    {
      "worker": "output_efficiency",
      "metrics": [
        "task_count",
        "command_success_rate",
        "useful_hit_rate",
        "useful_recall_at_256_bytes",
        "useful_recall_at_512_bytes",
        "useful_recall_at_1024_bytes",
        "useful_recall_at_2048_bytes",
        "useful_recall_at_4096_bytes",
        "useful_recall_at_8192_bytes",
        "useful_recall_at_16384_bytes",
        "output_bytes_p50",
        "output_bytes_p95",
        "first_useful_byte_p50",
        "duplicate_line_fraction",
        "scope_path_count",
        "scope_leak_path_count",
        "scope_leak_fraction",
        "scope_leak_task_rate",
        "useful_units_per_kib",
        "command_latency_ms_p50",
        "command_latency_ms_p95",
        "search_useful_hit_rate",
        "grep_useful_hit_rate",
        "graph_useful_hit_rate",
        "search_output_bytes_p50",
        "grep_output_bytes_p50",
        "graph_output_bytes_p50",
        "token_count_available",
        "efficiency_contract_evaluated",
        "efficiency_contract_gate_count",
        "efficiency_contract_violation_count",
        "efficiency_contract_pass",
        "grep_shadow_available",
        "grep_shadow_input_matches",
        "grep_identity_shadow_removed_fraction",
        "grep_identity_shadow_output_bytes_p95",
        "grep_identity_shadow_grep_output_bytes_p95",
        "grep_identity_shadow_efficiency_contract_violation_count",
        "grep_identity_shadow_efficiency_contract_pass",
        "grep_window_shadow_dropped_fraction",
        "grep_window_shadow_output_bytes_p95",
        "grep_window_shadow_useful_recall_at_512_bytes",
        "grep_window_shadow_duplicate_line_fraction",
        "grep_window_shadow_useful_units_per_kib",
        "grep_window_shadow_grep_output_bytes_p95",
        "grep_window_shadow_grep_useful_recall_at_512_bytes",
        "grep_window_shadow_grep_duplicate_line_fraction",
        "grep_window_shadow_grep_useful_units_per_kib",
        "grep_window_shadow_efficiency_contract_violation_count",
        "grep_window_shadow_efficiency_contract_pass"
      ]
    }
  ],
  "validate": {
    "require_files": [
      "metrics.json"
    ],
    "require_metrics": [
      "task_count",
      "command_success_rate",
      "useful_hit_rate",
      "output_bytes_p50",
      "scope_leak_fraction",
      "efficiency_contract_pass"
    ],
    "require_metric_status": [
      "ok"
    ]
  },
  "summarize": {
    "primary": [
      "useful_hit_rate",
      "useful_recall_at_256_bytes",
      "useful_recall_at_512_bytes",
      "useful_recall_at_1024_bytes",
      "useful_recall_at_4096_bytes",
      "output_bytes_p50",
      "output_bytes_p95",
      "first_useful_byte_p50",
      "duplicate_line_fraction",
      "scope_leak_fraction",
      "useful_units_per_kib",
      "command_latency_ms_p50",
      "search_useful_hit_rate",
      "grep_useful_hit_rate",
      "graph_useful_hit_rate",
      "efficiency_contract_violation_count",
      "efficiency_contract_pass",
      "grep_identity_shadow_removed_fraction",
      "grep_identity_shadow_output_bytes_p95",
      "grep_identity_shadow_grep_output_bytes_p95",
      "grep_identity_shadow_efficiency_contract_violation_count",
      "grep_window_shadow_dropped_fraction",
      "grep_window_shadow_output_bytes_p95",
      "grep_window_shadow_useful_recall_at_512_bytes",
      "grep_window_shadow_grep_output_bytes_p95",
      "grep_window_shadow_grep_useful_recall_at_512_bytes",
      "grep_window_shadow_grep_duplicate_line_fraction",
      "grep_window_shadow_grep_useful_units_per_kib",
      "grep_window_shadow_efficiency_contract_violation_count",
      "grep_window_shadow_efficiency_contract_pass"
    ]
  }
}
