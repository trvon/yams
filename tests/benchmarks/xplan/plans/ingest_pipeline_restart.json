{
  "name": "ingest_pipeline_restart",
  "description": "Simeon ingestion persistence, fresh-process SPQ reuse, and idempotent replay gate.",
  "build_dir": "build/release",
  "artifact_root": "build/benchmarks",
  "timeout_sec": 900,
  "continue_on_arm_failure": false,
  "mode": "synthetic",
  "repeats": 3,
  "baseline": "restart_replay",
  "fixed": {
    "env": {
      "YAMS_TEST_SAFE_SINGLE_INSTANCE": "1"
    },
    "params": {
      "corpus_size": 100,
      "doc_size": 8192,
      "poll_interval_ms": 20,
      "post_ingest_coalesce_ms": 2,
      "ingest_mode": "directory",
      "ingest_concurrency": 1,
      "lifecycle_phases": ["initial", "replay", "replay"],
      "require_complete_pipeline": true,
      "require_full_searchability": true,
      "require_experiment_identity": true,
      "require_full_oracle": true,
      "require_spq_persistence": true,
      "require_stable_retrieval_outcome": true,
      "minimum_vector_count": 256
    }
  },
  "arms": [
    {
      "name": "restart_replay",
      "factors": { "kg": "on", "vectors": "on", "gliner": "off" }
    }
  ],
  "steps": [
    {
      "worker": "ingestion_e2e",
      "metrics": [
        "total_duration_ms",
        "docs_per_s",
        "pipeline_complete",
        "dropped_batches",
        "storage_oracle_stored_documents",
        "storage_oracle_stored_vectors",
        "vector_index_authoritative_generation",
        "vector_index_source_generation",
        "vector_index_reusable_persisted_index",
        "resource_peak_rss_after_bytes",
        "resource_db_lock_errors",
        "resource_shutdown_succeeded",
        "write_coordinator_commit_errors",
        "write_coordinator_capacity_rejections"
      ]
    }
  ],
  "validate": {
    "require_files": ["metrics.json", "mode_manifest.json"],
    "require_metrics": [
      "total_duration_ms",
      "docs_per_s",
      "pipeline_complete",
      "dropped_batches",
      "storage_oracle_stored_documents",
      "storage_oracle_stored_vectors",
      "vector_index_reusable_persisted_index"
    ],
    "require_metric_status": ["ok"]
  },
  "summarize": {
    "primary": [
      "docs_per_s",
      "total_duration_ms",
      "pipeline_complete",
      "dropped_batches",
      "storage_oracle_stored_documents",
      "storage_oracle_stored_vectors",
      "vector_index_authoritative_generation",
      "vector_index_source_generation",
      "vector_index_reusable_persisted_index",
      "resource_peak_rss_after_bytes",
      "resource_db_lock_errors",
      "resource_shutdown_succeeded",
      "write_coordinator_commit_errors",
      "write_coordinator_capacity_rejections"
    ],
    "group_by": ["kg", "vectors", "gliner"]
  }
}
